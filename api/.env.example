# Copy to .env for local development. See IMPLEMENTATION.md section 2 for
# where each value comes from. Never commit the real .env file.

DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Paste the full service account JSON (Firebase Console > Project Settings
# > Service Accounts > Generate new private key) as one line. Optional —
# if unset, admin push notifications are silently disabled (server logs a
# warning at startup) rather than failing to run.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Base64-encoded 32-byte key (AES-256-GCM) used to encrypt Midtrans/Xendit
# credentials at rest. Generate one with: openssl rand -base64 32
# Optional — if unset, saving new payment settings returns 503 (server logs
# a warning at startup) rather than failing to run; reading existing
# settings still works.
PAYMENT_GATEWAY_ENCRYPTION_KEY=

# Shared static secret the POS app sends as `Authorization: Bearer <key>`
# (see api-pos-integration.md section 4). If unset, every request to
# /pos/* and POST/GET /pos/orders is rejected (server logs a warning at
# startup) rather than accidentally accepting any token.
POS_API_KEY=

# `next dev` also defaults to :3000 — when running web/ and api/ locally at
# the same time, change one of them (e.g. PORT=8080 here).
PORT=3000

# Not in IMPLEMENTATION.md's documented list. General-purpose infra, not
# actually required by web/ today — every call from web/ to this API goes
# through Next.js server-side code (Server Components / Route Handlers),
# never directly from the browser, so no CORS is needed for that path.
# Kept for any future client that does call this API directly from a
# browser. Comma-separated origins, e.g. https://tokokamu.com. Defaults to
# "*" (open) if unset — fine for MVP since public endpoints are meant to be
# public anyway.
CORS_ALLOWED_ORIGINS=http://localhost:3000
