# Copy to .env.local for local development. See IMPLEMENTATION.md section 2.
# Never commit the real .env.local file.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — the Go backend URL. Never exposed to the browser: every
# request to it goes through a Server Component or a Route Handler under
# app/api/, never directly from client code. During local dev this is
# wherever `go run .` in api/ is listening (see api/.env.example PORT).
GO_API_URL=http://localhost:8080

NEXT_PUBLIC_WHATSAPP_NUMBER=

# Firebase web app config object as one JSON line (from Firebase Console >
# Project Settings > General > Your apps > SDK setup and configuration),
# e.g. {"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}
NEXT_PUBLIC_FIREBASE_CONFIG=

# Not in IMPLEMENTATION.md's documented list, but required for FCM web
# push to work at all: Firebase Console > Project Settings > Cloud
# Messaging > Web configuration > Web Push certificates ("Generate key
# pair" if none exists yet). Safe to expose client-side like the config
# above.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
